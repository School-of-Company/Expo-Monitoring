    },
    {
      "type": "timeseries",
      "title": "활성 핸들·요청",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (nodejs_active_handles_total{service=\"expo-form-server\"})",
          "legendFormat": "핸들 {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (nodejs_active_requests_total{service=\"expo-form-server\"})",
          "legendFormat": "요청 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
