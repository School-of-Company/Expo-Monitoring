      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      }
    },
    {
      "type": "timeseries",
      "title": "DB 커넥션 풀 (Hikari)",
      "description": "대기(pending)가 0보다 크면 풀이 모자랍니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (hikaricp_connections_active{service=\"expo-report-server\"})",
          "legendFormat": "사용 중 {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (hikaricp_connections_idle{service=\"expo-report-server\"})",
          "legendFormat": "유휴 {{instance}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (hikaricp_connections_pending{service=\"expo-report-server\"})",
          "legendFormat": "대기 {{instance}}"
        },
        {
