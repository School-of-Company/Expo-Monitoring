{
  "uid": "expo-kafka",
  "title": "Expo / Kafka 이벤트 소비",
  "description": "박람회 변경 이벤트(expo.expo.changed)를 소비하는 서비스별 lag, DLT/DLQ 유입, 커밋 오프셋. 지표는 Alloy의 Kafka exporter가 모읍니다.",
  "tags": [
    "expo",
    "kafka"
  ],
  "links": [
    {
      "title": "Expo / Overview",
      "type": "link",
      "url": "/d/expo-overview",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "박람회 변경 이벤트 소비 (expo.expo.changed)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "컨슈머 그룹별 lag",
      "description": "그룹(expo-<서비스>-server.expo-changed)별로 아직 소비하지 않은 메시지 수. 이벤트가 드물어 평소에는 0이어야 합니다. 2분 넘게 0보다 크면 ExpoChangedConsumerLag가 발화합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_uncommitted_offsets{topic=\"expo.expo.changed\"})",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "현재 lag",
      "description": "그룹별 현재 lag. 0이 아니면 빨강입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_uncommitted_offsets{topic=\"expo.expo.changed\"})",
          "legendFormat": "{{consumergroup}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "DLT/DLQ 끝 오프셋 (누적 건수)",
      "description": "반영에 실패해 넘어간 메시지의 누적 수(파티션 끝 오프셋 합). Notification은 .dlq, 나머지는 .dlt입니다. 늘어나면 ExpoChangedDeadLetter가 발화합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{topic=~\"expo[.]expo[.]changed[.](dlt|dlq)\"})",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "stat",
      "title": "최근 10분 DLT/DLQ 유입",
      "description": "최근 10분 동안 늘어난 DLT/DLQ 메시지 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic) (increase(kafka_topic_partition_current_offset{topic=~\"expo[.]expo[.]changed[.](dlt|dlq)\"}[10m]))",
          "legendFormat": "{{topic}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "커밋 오프셋과 토픽 끝 오프셋",
      "description": "그룹이 커밋한 오프셋(파티션 합)과 토픽 끝 오프셋. 그래프가 마지막으로 올라간 지점이 마지막 커밋 시각입니다. 토픽 끝보다 아래에서 평평하면 소비가 멈춘 것입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_current_offset{topic=\"expo.expo.changed\"})",
          "legendFormat": "{{consumergroup}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"expo.expo.changed\"})",
          "legendFormat": "토픽 끝"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "stat",
      "title": "최근 5분 커밋 오프셋 변화 횟수",
      "description": "최근 5분 동안 커밋 오프셋이 바뀐 횟수. lag이 0보다 큰데 0이면 소비 정지 의심(ExpoChangedConsumerStalled)입니다. lag이 0이면 0이 정상입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup) (changes(kafka_consumergroup_current_offset{topic=\"expo.expo.changed\"}[5m]))",
          "legendFormat": "{{consumergroup}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 7,
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 19
      }
    },
    {
      "type": "row",
      "title": "전체 컨슈머 그룹",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "timeseries",
      "title": "토픽·그룹별 lag (전체)",
      "description": "브로커의 모든 컨슈머 그룹(SMS·설문 결과 등 박람회 변경 외 토픽 포함)의 lag. 알림은 expo.expo.changed만 봅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_uncommitted_offsets)",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 30
      }
    },
    {
      "type": "stat",
      "title": "그룹별 멤버 수",
      "description": "그룹에 붙어 있는 컨슈머 수. 0이면 그 그룹을 소비하는 프로세스가 없습니다(서비스 중지·리스너 정지).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_members)",
          "legendFormat": "{{consumergroup}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 30
      }
    }
  ]
}
