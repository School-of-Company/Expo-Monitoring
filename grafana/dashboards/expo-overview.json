        }
      },
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      }
    },
    {
      "type": "table",
      "title": "순차 스캔으로 읽은 행이 많은 테이블 (5분)",
      "description": "순차 스캔으로 읽은 행 수 상위 10개 테이블. 인덱스 후보를 찾을 때 봅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (owner_service, datname, relname) (rate(pg_stat_user_tables_seq_tup_read[5m])) > 0)",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "owner_service": true,
              "datname": true,
              "relname": true,
              "Value": true
            },
            "indexByName": {
              "owner_service": 0,
              "datname": 1,
              "relname": 2,
              "Value": 3
            },
            "renameByName": {
              "owner_service": "서비스",
              "datname": "DB",
              "relname": "테이블",
              "Value": "초당 읽은 행"
            }
          }
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      }
    },
    {
      "type": "timeseries",
      "title": "Redis 메모리 사용량",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
