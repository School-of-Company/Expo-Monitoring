        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres 인덱스 블록 히트율",
      "description": "인덱스 블록 중 shared buffers에서 찾은 비율(idx_blocks_hit ÷ (hit + read)).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pg:index_block_hit_ratio:rate5m",
          "legendFormat": "{{owner_service}} {{datname}}"
