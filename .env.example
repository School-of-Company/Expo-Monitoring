# Address of the Eureka server Prometheus queries (name `eureka` in prometheus.yml).
# Leave unset when Eureka runs on this Docker host; otherwise set its IP.
EUREKA_HOST=
GRAFANA_ADMIN_PASSWORD=change-me

# --- digest (daily/weekly summary; docs/digest.md) ---------------------------
# Values are set in .env, never committed. Empty = use the default / skip.
DISCORD_WEBHOOK_URL=
GRAFANA_TOKEN=
GRAFANA_USER=
GRAFANA_PASSWORD=
GRAFANA_PUBLIC_URL=
LOKI_URL=
PROMETHEUS_URL=
GRAFANA_URL=
DIGEST_TZ=
DIGEST_DAILY_AT=
DIGEST_WEEKLY_AT=
DIGEST_DASHBOARD_UID=
DIGEST_PANEL_IDS=
DIGEST_LOKI_QUERY=
DIGEST_LOKI_LIMIT=
DIGEST_SNAPSHOT_EXPIRES_SEC=
DIGEST_TOP_N=
DIGEST_LOG_TOP_N=
DIGEST_MIN_REQUESTS=
DIGEST_5XX_WARN_PCT=
DIGEST_5XX_CRIT_PCT=
DIGEST_P95_WARN_SEC=
DIGEST_P95_CRIT_SEC=
DIGEST_OUTBOX_AGE_WARN_SEC=
DIGEST_OUTBOX_AGE_CRIT_SEC=
DIGEST_POOL_WAITING_WARN=
