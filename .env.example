# Address of the Eureka server Prometheus queries (name `eureka` in prometheus.yml).
# Leave unset when Eureka runs on this Docker host; otherwise set its IP.
EUREKA_HOST=
GRAFANA_ADMIN_PASSWORD=change-me
# Discord webhook for Grafana alerts. Secret: set only in the server's .env.
DISCORD_WEBHOOK_URL=
# Host directory with the PM2 *.log files Alloy tails (read-only). Unset = ./logs (empty).
LOG_DIR=
# Retention. Unset = 168h (7 days).
LOKI_RETENTION_PERIOD=
TEMPO_RETENTION_PERIOD=
# URL operators open Grafana at; used for links inside alerts. Unset = http://127.0.0.1:3001.
GRAFANA_ROOT_URL=
