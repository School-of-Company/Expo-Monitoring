# Address of the Eureka server Prometheus queries (name `eureka` in prometheus.yml).
# Leave unset when Eureka runs on this Docker host; otherwise set its IP.
EUREKA_HOST=
GRAFANA_ADMIN_PASSWORD=change-me
# Discord webhook for Grafana alerts and Alertmanager (mounted as a secret file). Secret: set only in the server's .env.
DISCORD_WEBHOOK_URL=
# Host directory Alloy tails (read-only, **/*.log): the PM2 log dir in production, the services'
# EXPO_LOG_DIR (e.g. ~/.expo/logs) locally. Unset = ./logs (empty). See docs/logging.md.
LOG_DIR=
# Retention. Unset = 168h (7 days).
LOKI_RETENTION_PERIOD=
TEMPO_RETENTION_PERIOD=
# URL operators open Grafana at; used for links inside alerts. Unset = http://127.0.0.1:3001.
GRAFANA_ROOT_URL=

# --- digest (daily/weekly summary; docs/digest.md) ---------------------------
# Values are set in .env, never committed. DISCORD_WEBHOOK_URL above is shared with the digest. Empty = use the default / skip.
GRAFANA_TOKEN=
GRAFANA_USER=
GRAFANA_PASSWORD=
GRAFANA_PUBLIC_URL=
LOKI_URL=
PROMETHEUS_URL=
GRAFANA_URL=
DIGEST_TZ=
DIGEST_DAILY_AT=
DIGEST_WEEKLY_AT=
DIGEST_DASHBOARD_UID=
DIGEST_PANEL_IDS=
DIGEST_LOKI_QUERY=
DIGEST_LOKI_LIMIT=
DIGEST_SNAPSHOT_EXPIRES_SEC=
DIGEST_TOP_N=
DIGEST_LOG_TOP_N=
DIGEST_MIN_REQUESTS=
DIGEST_5XX_WARN_PCT=
DIGEST_5XX_CRIT_PCT=
DIGEST_P95_WARN_SEC=
DIGEST_P95_CRIT_SEC=
DIGEST_OUTBOX_AGE_WARN_SEC=
DIGEST_OUTBOX_AGE_CRIT_SEC=
DIGEST_POOL_WAITING_WARN=
